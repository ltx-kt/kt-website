---
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/cursor.css';
import '../styles/terminal-frame.css';
import '../styles/section.css';
import '../styles/about.css';
import '../styles/timeline.css';
import '../styles/projects.css';
import '../styles/skills.css';
import '../styles/education.css';
import '../styles/resume.css';
import '../styles/contact.css';
import '../styles/animations.css';

interface Props {
  title?: string;
}
const { title = "KT's Website" } = Astro.props;

const tree = [
  { id: 'home',       label: 'home.tsx',    icon: '⌂' },
  { id: 'about',      label: 'about.md',    icon: '✎' },
  { id: 'experience', label: 'career.log',  icon: '⏱' },
  { id: 'projects',   label: 'projects/',   icon: '▸' },
  { id: 'skills',     label: 'stack.json',  icon: '{}' },
  { id: 'education',  label: 'edu.txt',     icon: '◧' },
  { id: 'resume',     label: 'resume.pdf',  icon: '⎙' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Kevin Tran — Software Engineer" />
  <meta name="theme-color" content="#9e293a" />
  <title>{title}</title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Preconnect for Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <!-- Custom blend-mode cursor (hidden on touch via CSS) -->
  <div class="cursor-dot" aria-hidden="true"></div>
  <div class="cursor-ring" aria-hidden="true"></div>

  <div class="layout-terminal">
    <!-- Mac-style window titlebar -->
    <div class="tm-titlebar">
      <span class="tm-dot red" aria-hidden="true"></span>
      <span class="tm-dot yellow" aria-hidden="true"></span>
      <span class="tm-dot green" aria-hidden="true"></span>
      <span class="tm-window-title">~/portfolio — kevin tran</span>
      <span class="tm-window-meta">main · v1.0.0</span>
    </div>

    <div class="tm-body">
      <!-- File-tree sidebar nav -->
      <aside class="tm-sidebar" aria-label="File explorer">
        <div class="tm-sb-section">EXPLORER</div>
        <ul class="tm-tree" role="list">
          <li class="tm-tree-folder" aria-hidden="true">▾ portfolio/</li>
          {tree.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="tm-tree-file"
                data-section={item.id}
                aria-label={item.label}
              >
                <span class="tm-tree-icon" aria-hidden="true">{item.icon}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="tm-sb-section">STATUS</div>
        <div class="tm-status" aria-label="Project status">
          <div>
            <span class="tm-ok-dot" aria-hidden="true"></span>
            <span>available</span>
          </div>
          <div class="tm-status-meta">git: clean</div>
          <div class="tm-status-meta">branch: main</div>
        </div>
      </aside>

      <!-- Main content -->
      <main class="tm-main">
        <slot />
      </main>
    </div>

    <!-- IDE-style status bar -->
    <div class="tm-statusbar" role="status" aria-live="polite">
      <span>● main</span>
      <span>UTF-8</span>
      <span>Ln 1, Col 1</span>
      <span class="tm-statusbar-right">Software Engineer · Portfolio</span>
    </div>
  </div>

  <script>
    // Sync file-tree active state with the visible section as the user scrolls
    const ids = ['home','about','experience','projects','skills','education','resume'];

    const links = new Map<string, Element>();
    document.querySelectorAll('.tm-tree-file[data-section]').forEach(el => {
      const s = el.getAttribute('data-section');
      if (s) links.set(s, el);
    });

    links.get('home')?.classList.add('active');

    // Tracks which observed sections are currently inside the observer band.
    const intersecting = new Set<string>();
    // Suppressed while a click-driven scroll is in flight so the observer
    // doesn't overwrite the clicked tab (short/last sections never enter the band).
    let clickedRecently = false;
    let suppressionTimer: number | null = null;

    function applyActive() {
      // ids[] matches DOM order; pick the topmost section in the band.
      for (const id of ids) {
        if (intersecting.has(id)) {
          links.forEach(el => el.classList.remove('active'));
          links.get(id)?.classList.add('active');
          return;
        }
      }
      // No tracked section in the band (e.g. scrolled into #contact) —
      // leave the last active tab untouched.
    }

    const obs = new IntersectionObserver(
      (entries) => {
        // Always track state so we can reconcile when suppression ends.
        entries.forEach((e) => {
          if (e.isIntersecting) intersecting.add(e.target.id);
          else intersecting.delete(e.target.id);
        });
        if (!clickedRecently) applyActive();
      },
      { rootMargin: '-40% 0px -50% 0px', threshold: 0 }
    );

    ids.forEach(id => {
      const el = document.getElementById(id);
      if (el) obs.observe(el);
    });

    links.forEach((el) => {
      el.addEventListener('click', () => {
        clickedRecently = true;
        links.forEach(l => l.classList.remove('active'));
        el.classList.add('active');
        // Clear any previous timer so rapid clicks don't stack.
        if (suppressionTimer !== null) window.clearTimeout(suppressionTimer);
        suppressionTimer = window.setTimeout(() => {
          clickedRecently = false;
          suppressionTimer = null;
          // Reconcile: if the user scrolled during suppression, apply
          // whatever section is now in the band.
          applyActive();
        }, 700);
      });
    });
  </script>

  <script>
    // Reveal-on-scroll: fade + rise for [data-animate], staggered children
    // for [data-animate-stagger]. CSS in animations.css handles the visuals
    // and respects prefers-reduced-motion.
    const animObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            animObs.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
    );
    document
      .querySelectorAll('[data-animate], [data-animate-stagger]')
      .forEach((el) => animObs.observe(el));
  </script>
</body>
</html>
